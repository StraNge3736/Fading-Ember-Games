ADMIN_PASSWORD=change-this-to-a-private-password
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_USERNAME=studio-admin
APP_BASE_URL=https://yourdomain.com

# Hostinger Node.js Web App: use the port configured by the hosting panel.
PORT=3000
HOST=0.0.0.0
# Set DATA_DIR to a private, writable directory outside the deployment/release folders.
# Example: DATA_DIR=/home/your-hosting-user/private/fading-ember-data

# Server-side SMTP. For Gmail, use an App Password (not your normal login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=
SMTP_FROM="Fading Ember Games <your-account@gmail.com>"
