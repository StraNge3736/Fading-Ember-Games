APP_BASE_URL=https://fadingembergames.com

# Hostinger MySQL database details (create a database and user in hPanel first).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=replace_with_a_long_database_password

# Verified studio identity. Use a long unique password for initial setup.
ADMIN_USERNAME=your_admin_username
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=choose_a_long_unique_password_for_first_setup

# SMTP relay. Use port 465 with SMTP_SECURE=true or port 587 with false.
# SMTP_FROM must be a sender email address accepted by your mail provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM=your_verified_sender@example.com
